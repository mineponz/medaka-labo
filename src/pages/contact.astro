---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, CONTACT_EMAIL_PLACEHOLDER } from '../consts';

/**
 * お問い合わせページ。
 *
 * 連絡先は src/consts.ts の CONTACT_EMAIL に置いてある。
 * !!! 現在はプレースホルダ。本番公開前に必ず実在のアドレスへ差し替えること !!!
 * 差し替えるまでは mailto リンクを出さず「準備中」と表示する（存在しない宛先を案内しないため）。
 */
const title = 'お問い合わせ';
const description = 'めだか飼育ラボへのご指摘・ご要望・その他のお問い合わせ先です。';

const isPlaceholder = CONTACT_EMAIL === CONTACT_EMAIL_PLACEHOLDER;
---

<BaseLayout title={title} description={description} breadcrumb={[]}>
  <h1>お問い合わせ</h1>
  <p class="lead">
    記事内容の誤り、リンク切れ、その他のご指摘・ご要望があればご連絡ください。
    個人で運営しているため、すべてのご連絡に返信できるとは限りません。ご了承ください。
  </p>

  <h2>連絡先</h2>
  {isPlaceholder ? (
    <p class="notice">
      現在、お問い合わせ用の連絡先を準備中です。準備ができ次第このページに掲載します。
    </p>
  ) : (
    <p class="contact-address">
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  )}

  <h2>ご連絡いただくときのお願い</h2>
  <p>
    記事内容の誤りをご指摘いただく場合、次の情報があると確認しやすくなります。
  </p>
  <ul>
    <li>どの記事か（URL）</li>
    <li>誤っていると思われる箇所と、その根拠（可能であれば）</li>
  </ul>
  <p>
    当サイトはメダカ飼育用品の紹介サイトであり、メダカ個体の販売・取引の仲介は行っていません。
    生体に関するお問い合わせにはお答えできません。
  </p>

  <style>
    .lead { color: var(--muted); margin-top: 0; }

    .notice {
      background: var(--surface);
      border: 1px dashed var(--border);
      border-radius: 8px;
      padding: 0.9rem 1rem;
      color: var(--muted);
    }

    .contact-address {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.9rem 1rem;
      font-family: var(--mono);
    }

    ul { padding-left: 1.25rem; }
    li { margin-bottom: 0.35rem; }
  </style>
</BaseLayout>
