---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, CONTACT_EMAIL, CONTACT_EMAIL_PLACEHOLDER } from '../consts';

/**
 * お問い合わせページ。
 *
 * 連絡先は src/consts.ts の CONTACT_EMAIL に置いてある。
 * !!! 現在はプレースホルダ。本番公開前に必ず実在のアドレスへ差し替えること !!!
 * 差し替えるまでは mailto リンクを出さず「準備中」と表示する（存在しない宛先を案内しないため）。
 */
const title = 'お問い合わせ';
const description = `${SITE_TITLE}へのご指摘・ご要望・その他のお問い合わせ先です。`;

const isPlaceholder = CONTACT_EMAIL === CONTACT_EMAIL_PLACEHOLDER;
---

<BaseLayout title={title} description={description} breadcrumb={[]}>
  <h1>お問い合わせ</h1>
  <p class="lead">
    記事の間違いやリンク切れ、そのほか気になることがあれば教えてください。
    個人でやっているサイトなので、いただいたご連絡すべてにお返事できるとは限りません。
    そこはご容赦ください。
  </p>

  <h2>連絡先</h2>
  {isPlaceholder ? (
    <p class="notice">
      お問い合わせ用の連絡先はただいま準備中です。用意でき次第、このページに載せます。
    </p>
  ) : (
    <p class="contact-address">
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </p>
  )}

  <h2>ご連絡いただくときのお願い</h2>
  <p>
    記事の間違いを教えていただけるときは、次の2つがあると確認がスムーズです。
  </p>
  <ul>
    <li>どの記事か（URL）</li>
    <li>間違っていそうな箇所と、できればその根拠</li>
  </ul>
  <p>
    それから、当サイトはめだか・金魚の飼育用品を紹介するサイトで、生体の販売や取引の仲介はしていません。
    生体そのものについてのお問い合わせにはお答えできませんので、あらかじめご了承ください。
  </p>

  <style>
    .lead { color: var(--muted); margin-top: 0; }

    .notice {
      background: var(--surface);
      border: 1px dashed var(--border);
      border-radius: 8px;
      padding: 0.9rem 1rem;
      color: var(--muted);
    }

    .contact-address {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.9rem 1rem;
      font-family: var(--mono);
    }

    ul { padding-left: 1.25rem; }
    li { margin-bottom: 0.35rem; }
  </style>
</BaseLayout>
