---
import { AMAZON_ASSOCIATE_TAG } from '../consts';

/**
 * Amazonの検索結果ページへの誘導リンク。
 *
 * 特定商品（ASIN）ではなく検索キーワードにリンクしている。個別商品ページへの直リンクは
 * 実在する正しいASINでないと誤った商品に誘導してしまうため、実物を確認せずASINを
 * 記事に書くのは避けた（本人が実際に使う商品を選定したら、この記事内のリンクを
 * `https://www.amazon.co.jp/dp/<実在のASIN>?tag=...` に個別に差し替えることを推奨）。
 * `AMAZON_ASSOCIATE_TAG` が本物のタグに差し替わるまでは、生成されるURLは
 * 実在するがトラッキングされない（＝報酬が発生しない）リンクになる。
 */
interface Props {
  keyword: string;
  label: string;
}

const { keyword, label } = Astro.props;
const href = `https://www.amazon.co.jp/s?k=${encodeURIComponent(keyword)}&tag=${AMAZON_ASSOCIATE_TAG}`;
---

<a class="amazon-link" href={href} rel="nofollow noopener sponsored" target="_blank">
  {label}
</a>

<style>
  .amazon-link {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.5rem 0.9rem;
    background: var(--accent-weak);
    border: 1px solid var(--accent);
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .amazon-link:hover {
    background: var(--accent);
    color: var(--surface);
  }
</style>
