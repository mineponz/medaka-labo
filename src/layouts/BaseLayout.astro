---
import {
  SITE_URL,
  SITE_TITLE,
  SITE_DESCRIPTION,
  AMAZON_ASSOCIATE_TAG,
  AMAZON_ASSOCIATE_TAG_PLACEHOLDER,
  GA_MEASUREMENT_ID,
} from '../consts';

interface Props {
  /** ページ固有のタイトル。トップページでは省略する */
  title?: string;
  description?: string;
  /** パンくずの中間項目（トップとページ自身は自動で付く） */
  breadcrumb?: { label: string; href: string }[];
  /**
   * 本文の末尾にXシェアボタンを出すか。記事ページ（src/pages/articles/*.astro）でのみ true にする。
   * トップ・プライバシーポリシー・お問い合わせ・404では出さない。
   */
  shareable?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  breadcrumb = [],
  shareable = false,
} = Astro.props;
// Amazonアソシエイトの開示文言は、審査通過前（＝タグがプレースホルダのまま）は
// 事実と異なる（まだ収入を得ていない）ため出さない。タグ差し替え後に自動で表示される。
const isAssociateTagPlaceholder = AMAZON_ASSOCIATE_TAG === AMAZON_ASSOCIATE_TAG_PLACEHOLDER;

const fullTitle = title
  ? `${title} | ${SITE_TITLE}`
  : `${SITE_TITLE} — めだか・金魚の飼育用品の選び方ガイド`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

// パンくずの構造化データ。トップ → 中間 → 現在ページ
const crumbs = [
  { label: 'ホーム', href: '/' },
  ...breadcrumb,
  ...(title ? [{ label: title, href: Astro.url.pathname }] : []),
];

// Xの投稿画面へのリンク。記事タイトルはビルド時に確定しているのでクライアントJSは不要
// （文面は <title> と同じ「記事タイトル | サイト名」。二重管理しないよう fullTitle を再利用する）。
const shareUrl = shareable
  ? `https://x.com/intent/tweet?text=${encodeURIComponent(fullTitle)}&url=${encodeURIComponent(canonical)}`
  : null;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, SITE_URL).href,
  })),
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="google-site-verification" content="HmkChSgQuPhmfw3e0N9eLgLYi3bLDWkyt37TXtiapK0" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />

    <!-- Google tag (gtag.js) -->
    <script
      async
      is:inline
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>
    <script define:vars={{ GA_MEASUREMENT_ID }} is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <header class="site-header">
      <a href="/" class="wordmark">{SITE_TITLE}</a>
      <p class="tagline">めだか・金魚の飼育用品の選び方ガイド</p>
    </header>

    {crumbs.length > 1 && (
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {i === crumbs.length - 1 ? (
                <span aria-current="page">{c.label}</span>
              ) : (
                <a href={c.href}>{c.label}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <main id="main">
      <slot />

      {shareUrl && (
        <aside class="share" aria-label="この記事をシェア">
          <p class="share-lead">この記事が役に立ったら、シェアしてもらえると嬉しいです。</p>
          <a class="share-link" href={shareUrl} target="_blank" rel="noopener noreferrer">
            Xでシェア
          </a>
        </aside>
      )}
    </main>

    <footer class="site-footer">
      {!isAssociateTagPlaceholder && (
        <p>
          当サイトは、Amazonアソシエイト・プログラムの参加者として、
          適格販売により収入を得ています。
        </p>
      )}
      <nav class="meta" aria-label="サイト情報">
        <a href="/">記事一覧</a>
        <a href="/privacy/">プライバシーポリシー</a>
        <a href="/contact/">お問い合わせ</a>
      </nav>
    </footer>

    <style is:global>
      :root {
        --bg: #f7fafb;
        --surface: #ffffff;
        --border: #d7e3e6;
        --text: #1c2426;
        --muted: #62767c;
        --accent: #0d7ea3;
        --accent-weak: #e3f2f7;
        --danger: #9d2f24;
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
        --sans: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN",
          "Noto Sans JP", "Yu Gothic", sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14191b;
          --surface: #1c2427;
          --border: #2f3a3e;
          --text: #e6ecee;
          --muted: #93a3a7;
          --accent: #5fc4e8;
          --accent-weak: #1c2f36;
          --danger: #e08278;
        }
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        line-height: 1.75;
        -webkit-text-size-adjust: 100%;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
      }
      .skip-link:focus {
        left: 1rem;
        top: 1rem;
        z-index: 10;
        background: var(--surface);
        padding: 0.5rem 0.75rem;
        border: 2px solid var(--accent);
        border-radius: 4px;
      }

      .site-header,
      .breadcrumb,
      main,
      .site-footer {
        max-width: 46rem;
        margin-inline: auto;
        padding-inline: 1.25rem;
      }

      .site-header {
        padding-top: 2.5rem;
        padding-bottom: 1.25rem;
      }

      .wordmark {
        font-family: var(--mono);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--text);
        text-decoration: none;
      }
      .wordmark:hover { color: var(--accent); }

      .tagline {
        margin: 0.15rem 0 0;
        color: var(--muted);
        font-size: 0.875rem;
      }

      .breadcrumb ol {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.8125rem;
        color: var(--muted);
      }
      .breadcrumb li + li::before {
        content: "/";
        margin-right: 0.4rem;
        color: var(--border);
      }
      .breadcrumb a { color: var(--muted); }

      main { padding-block: 1.5rem 3rem; }

      h1 {
        font-size: 1.75rem;
        line-height: 1.35;
        letter-spacing: -0.01em;
        margin: 0.5rem 0 0.75rem;
      }
      h2 {
        font-size: 1.15rem;
        margin-top: 2.5rem;
        margin-bottom: 0.5rem;
      }

      a { color: var(--accent); }

      code, kbd, pre { font-family: var(--mono); font-size: 0.9em; }

      code:not(pre code) {
        background: var(--accent-weak);
        padding: 0.1em 0.35em;
        border-radius: 3px;
      }

      .site-footer {
        border-top: 1px solid var(--border);
        padding-block: 1.5rem 3rem;
        color: var(--muted);
        font-size: 0.8125rem;
      }
      .site-footer p { margin: 0 0 0.5rem; }
      .site-footer .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.25rem;
      }
    </style>

    <style>
      /*
        記事末尾のシェア導線。記事内の主要CTA（AmazonLink = accent色の枠線＋淡い塗り＋太字）より
        弱い副次アクションとして、色を持たないニュートラルな枠線のみのボタンにしている。
        余白は8px系（32/24/16/8px）。
      */
      .share {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
      }
      .share-lead {
        margin: 0 0 0.5rem;
        color: var(--muted);
        font-size: 0.8125rem;
      }
      .share-link {
        display: inline-block;
        padding: 0.5rem 1rem;
        border: 1px solid var(--muted);
        border-radius: 6px;
        color: var(--text);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
      }
      /*
        hoverでも文字色は --text のまま（--accent は --bg 上で 4.42:1 と AA を僅かに割るため、
        ここでは色ではなく枠線と淡い塗りで反応を出す）。
      */
      .share-link:hover {
        border-color: var(--accent);
        background: var(--accent-weak);
      }
    </style>
  </body>
</html>
